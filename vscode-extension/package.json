{
  "name": "kafkasql-vscode",
  "displayName": "KafkaSQL",
  "publisher": "your-publisher",
  "version": "0.0.1",
  "engines": { "vscode": "^1.60.0" },
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kafkasqlExplorer",
          "title": "KafkaSQL",
          "icon": "./images/kafkasql.svg"
        }
      ]
    },
    "views": {
      "kafkasqlExplorer": [
        {
          "id": "kafkasqlProjectExplorer",
          "name": "Project",
          "icon": "./images/kafkasql.svg"
        }
      ]
    },
    "languages": [
      {
        "id": "kafkasql",
        "aliases": ["KafkaSQL"],
        "extensions": [".kafka", ".kafkasql"],
        "configuration": "./syntaxes/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kafkasql",
        "scopeName": "source.kafkasql",
        "path": "./syntaxes/kafkasql.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "kafkasql.startServer",
        "title": "KafkaSQL: Start Language Server"
      },
      {
        "command": "kafkasql.selectForCompare",
        "title": "KafkaSQL: Select for Compare"
      },
      {
        "command": "kafkasql.compareWithSelected",
        "title": "KafkaSQL: Compare with Selected"
      },
      {
        "command": "kafkasql.compareWithActive",
        "title": "KafkaSQL: Compare Active File With..."
      },
      {
        "command": "kafkasql.changeComparisonMode",
        "title": "KafkaSQL: Change Comparison Mode"
      },
      {
        "command": "kafkasql.explorer.refresh",
        "title": "KafkaSQL: Refresh Project Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "kafkasql.explorer.toggleFlatContexts",
        "title": "KafkaSQL: Toggle Flat/Nested Contexts",
        "icon": "$(list-flat)"
      },
      {
        "command": "kafkasql.explorer.expandAll",
        "title": "KafkaSQL: Expand All",
        "icon": "$(expand-all)"
      },
      {
        "command": "kafkasql.explorer.collapseAll",
        "title": "KafkaSQL: Collapse All",
        "icon": "$(collapse-all)"
      },
      {
        "command": "kafkasql.explorer.openFile",
        "title": "KafkaSQL: Open File"
      },
      {
        "command": "kafkasql.diffWithCluster",
        "title": "KafkaSQL: Diff with Cluster",
        "icon": "$(diff)"
      },
      {
        "command": "kafkasql.deployToCluster",
        "title": "KafkaSQL: Deploy to Cluster",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "kafkasql.deployProjectToCluster",
        "title": "KafkaSQL: Deploy to...",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "kafkasql.executeStatement",
        "title": "KafkaSQL: Execute Statement",
        "icon": "$(play)"
      },
      {
        "command": "kafkasql.newQuery",
        "title": "KafkaSQL: New Query",
        "icon": "$(new-file)"
      },
      {
        "command": "kafkasql.addConnection",
        "title": "KafkaSQL: Add Connection",
        "icon": "$(add)"
      },
      {
        "command": "kafkasql.editConnection",
        "title": "KafkaSQL: Edit Connection",
        "icon": "$(edit)"
      },
      {
        "command": "kafkasql.removeConnection",
        "title": "KafkaSQL: Remove Connection",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kafkasql.explorer.toggleFlatContexts",
          "when": "view == kafkasqlProjectExplorer",
          "group": "navigation@1"
        },
        {
          "command": "kafkasql.explorer.expandAll",
          "when": "view == kafkasqlProjectExplorer",
          "group": "navigation@2"
        },
        {
          "command": "kafkasql.explorer.collapseAll",
          "when": "view == kafkasqlProjectExplorer",
          "group": "navigation@3"
        },
        {
          "command": "kafkasql.explorer.refresh",
          "when": "view == kafkasqlProjectExplorer",
          "group": "navigation@4"
        },
        {
          "command": "kafkasql.addConnection",
          "when": "view == kafkasqlProjectExplorer",
          "group": "navigation@5"
        }
      ],
      "editor/title": [
        {
          "command": "kafkasql.executeStatement",
          "when": "resourceExtname == .kafka || resourceExtname == .kafkasql || editorLangId == kafkasql",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "kafkasql.executeStatement",
          "when": "resourceExtname == .kafka || resourceExtname == .kafkasql || editorLangId == kafkasql",
          "group": "kafkasql@1"
        }
      ],
      "explorer/context": [
        {
          "command": "kafkasql.selectForCompare",
          "when": "resourceExtname == .kafka || resourceExtname == .kafkasql",
          "group": "kafkasql@1"
        },
        {
          "command": "kafkasql.compareWithSelected",
          "when": "(resourceExtname == .kafka || resourceExtname == .kafkasql) && kafkasql.compareBase",
          "group": "kafkasql@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "kafkasql.compareWithActive",
          "when": "resourceExtname == .kafka || resourceExtname == .kafkasql",
          "group": "kafkasql@1"
        }
      ],
      "view/item/context": [
        {
          "command": "kafkasql.deployProjectToCluster",
          "when": "view == kafkasqlProjectExplorer && viewItem == kafkasqlProject",
          "group": "kafkasql@1"
        },
        {
          "command": "kafkasql.diffWithCluster",
          "when": "view == kafkasqlProjectExplorer && viewItem == kafkasqlConnection",
          "group": "kafkasql@1"
        },
        {
          "command": "kafkasql.deployToCluster",
          "when": "view == kafkasqlProjectExplorer && viewItem == kafkasqlConnection",
          "group": "kafkasql@2"
        },
        {
          "command": "kafkasql.newQuery",
          "when": "view == kafkasqlProjectExplorer && viewItem == kafkasqlConnection",
          "group": "kafkasql@3"
        },
        {
          "command": "kafkasql.editConnection",
          "when": "view == kafkasqlProjectExplorer && viewItem == kafkasqlConnection",
          "group": "kafkasql@4"
        },
        {
          "command": "kafkasql.removeConnection",
          "when": "view == kafkasqlProjectExplorer && viewItem == kafkasqlConnection",
          "group": "kafkasql@5"
        },
        {
          "command": "kafkasql.addConnection",
          "when": "view == kafkasqlProjectExplorer && viewItem == kafkasqlClustersRoot",
          "group": "inline"
        },
        {
          "command": "kafkasql.newQuery",
          "when": "view == kafkasqlProjectExplorer && viewItem == kafkasqlConnection",
          "group": "inline@1"
        },
        {
          "command": "kafkasql.editConnection",
          "when": "view == kafkasqlProjectExplorer && viewItem == kafkasqlConnection",
          "group": "inline@2"
        },
        {
          "command": "kafkasql.removeConnection",
          "when": "view == kafkasqlProjectExplorer && viewItem == kafkasqlConnection",
          "group": "inline@3"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . -w",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/vscode": "^1.60.0",
    "@types/node": "^20.0.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
-- read-test.kafka
-- Tests reading records from each stream in the demo project.
-- Run this with the Execute Statement button against a live cluster.

INCLUDE '../contexts/customers.kafka';
INCLUDE '../streams/customers/Customers.kafka';

-- Cursor `read-test` is declared in model/groups/customers/read-test.kafka.

-- ── customers.Customers — all active customers ────────────────────────────────

READ FROM customers.Customers
  --FROM BEGINNING
  --STOP AFTER 10 SECONDS
  --FROM CURSOR 'customers.read-test'
  TYPE CustomerRecord
    Key     AS CustomerId,
    Value.Name AS CustomerName
  WHERE Value.Status = customers.CustomerStatus::ACTIVE;

